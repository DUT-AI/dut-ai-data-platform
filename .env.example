# Environment Configuration for DUT AI Data Platform

# PostgreSQL Database Configuration
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_dev
POSTGRES_DB=ai_data_platform
DATABASE_URL=postgresql+asyncpg://platform:platform_dev@db:5432/ai_data_platform

# Redis Cache & Broker Configuration
REDIS_URL=redis://redis:6379/0

# Security & JWT Configuration
JWT_SECRET_KEY=change-this-to-a-very-secure-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# MinIO / S3 Storage Configuration
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
DEFAULT_BUCKET=ai-data-platform
MINIO_SECURE=false

# External Auth & Manage Server
AUTH_SERVER_URL=https://manage.dutai.site/api/v1
MANAGE_SERVER_URL=https://manage.dutai.io.vn/api/v1

# API & Frontend Configuration
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
