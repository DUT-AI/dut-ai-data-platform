# Environment Configuration for DUT AI Data Platform (.env.example)
# IMPORTANT: This file contains only safe placeholder templates. Never commit real secrets.

# PostgreSQL Database Configuration
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@localhost:5432/your_database_name

# Redis Cache & Broker Configuration
REDIS_URL=redis://localhost:6379/0

# RabbitMQ AMQP Broker Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Inference & vLLM Runtime Configuration
INFERENCE_PROTOCOL=http
LLM_API_BASE_URL=https://llm.example.com/v1
LLM_DEFAULT_MODEL=ggml-org/gemma-4-e4b-it-GGUF:Q4_0
LLM_API_KEY=your_llm_api_key
GRPC_RUNTIME_HOST=localhost
GRPC_RUNTIME_PORT=50051

# DUT AI SSO: tokens are issued by DUT AI Manage, the Data Platform only verifies them.
# JWT_SECRET_KEY MUST equal DUT AI Manage SECRET_KEY, otherwise every SSO token is rejected.
JWT_SECRET_KEY=same-value-as-dut-ai-manage-SECRET_KEY
JWT_ALGORITHM=HS256

# Shared SSO cookies (same names/scope as DUT AI Manage)
AUTH_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
# Production: .dutai.io.vn | Local dev: empty (host-only cookie on localhost)
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Local dev only: email/password login proxied to Manage. MUST be false in production.
AUTH_LOCAL_LOGIN_ENABLED=true
# Minimum minutes between two last_login_at writes per user
ACTIVITY_RECORD_INTERVAL_MINUTES=15

# DUT AI Manage
AUTH_SERVER_URL=https://manage.dutai.io.vn/api/v1/auth/login
USER_ENDPOINT=https://manage.dutai.io.vn/api/v1/users
MANAGE_API_TOKEN=your_manage_api_token
EXTERNAL_API_TIMEOUT=10.0

# Host ports published on 127.0.0.1 by docker compose
# Server (dutai-minipc): WEB_HOST_PORT=3036 (tunnel dataplatform.dutai.io.vn), API_HOST_PORT=8010
WEB_HOST_PORT=3036
API_HOST_PORT=8000

# MinIO / S3 Storage Configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
DEFAULT_BUCKET=your_bucket_name
MINIO_SECURE=false

# Orphaned asset object cleanup (worker). Runs in dry-run (log only) until set to false.
ORPHAN_CLEANUP_ENABLED=true
ORPHAN_CLEANUP_DRY_RUN=true
ORPHAN_CLEANUP_INTERVAL_SECONDS=21600
ORPHAN_CLEANUP_MIN_AGE_HOURS=24

# API & Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
# Web build variables live in web/.env (see web/.env.example)
