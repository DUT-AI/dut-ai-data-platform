# Environment Configuration for DUT AI Data Platform (.env.example)
# IMPORTANT: This file contains only safe placeholder templates. Never commit real secrets.

# PostgreSQL Database Configuration
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@localhost:5432/your_database_name

# Redis Cache & Broker Configuration
REDIS_URL=redis://localhost:6379/0

# Security & JWT Configuration
JWT_SECRET_KEY=change-this-to-a-very-secure-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Cookie Authentication Configuration
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_MAX_AGE=86400

# External Auth & Manage Server
AUTH_SERVER_URL=https://auth.example.com/api/v1
MANAGE_SERVER_URL=https://manage.example.com/api/v1
EXTERNAL_API_TIMEOUT=10.0

# MinIO / S3 Storage Configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
DEFAULT_BUCKET=your_bucket_name
MINIO_SECURE=false

# Label Studio Configuration
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_INTERNAL_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=your_label_studio_api_key
LABEL_STUDIO_USERNAME=your_email@example.com
LABEL_STUDIO_PASSWORD=your_label_studio_password
LABEL_STUDIO_HOST=http://localhost:8080
LABEL_STUDIO_PORT=8080
PLATFORM_WEBHOOK_URL=http://localhost:8000/api/v1/annotations/sync

# API & Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
