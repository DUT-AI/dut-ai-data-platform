NEXT_PUBLIC_APP_NAME="DUT AI Data Platform"

# Local dev (pnpm dev on http://localhost:3000/data, API via `make dev-api`)
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_LOCAL_LOGIN_ENABLED="true"
NEXT_PUBLIC_SSO_LOGIN_URL=""
NEXT_PUBLIC_SSO_LOGOUT_REDIRECT=""
# Same-origin proxy target for /data/api/* (unset = http://127.0.0.1:8002)
# API_PROXY_ORIGIN="http://127.0.0.1:8000"

# Production (read at `docker compose build web`):
# NEXT_PUBLIC_API_BASE_URL="/data/api/v1"
# NEXT_PUBLIC_LOCAL_LOGIN_ENABLED="false"
# NEXT_PUBLIC_SSO_LOGIN_URL="https://workspace.dutai.io.vn/manage/login"
# NEXT_PUBLIC_SSO_LOGOUT_REDIRECT="https://workspace.dutai.io.vn/"
# API_PROXY_ORIGIN="http://api:8000"
